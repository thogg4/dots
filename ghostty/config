theme = TokyoNight Night
background-opacity = 0.85
scrollback-limit = 100000
cursor-style = block
cursor-style-blink = false
maximize = true
# cmd+shift+up/down go to herdr (spaces).
keybind = cmd+shift+up=unbind
keybind = cmd+shift+down=unbind
# cmd+k goes to herdr, which clears just the focused pane.
keybind = cmd+k=unbind
# cmd+t goes to herdr, which opens a new tab.
keybind = cmd+t=unbind
# Per-machine overrides written by setup.sh (e.g. `command` when fish
# can't be the login shell). Optional and gitignored.
config-file = ?local
